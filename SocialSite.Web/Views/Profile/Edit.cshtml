@model ProfileEditDto
@{
    ViewData["Title"] = "Nastavení";
}

<section class="container page">
    <article class="card">
        <h2>Nastavení profilu</h2>
        @if (TempData["Message"] is string message)
        {
            <div class="alert">@message</div>
        }
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="DateOfBirth"></label>
                <input asp-for="DateOfBirth" type="date" class="form-control" />
                <span asp-validation-for="DateOfBirth" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Bio"></label>
                <textarea asp-for="Bio" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Bio" class="field-error"></span>
            </div>
            <button type="submit" class="btn btn-primary">Uložit změny</button>
        </form>
    </article>
</section>

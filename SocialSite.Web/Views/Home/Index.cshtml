@model IReadOnlyList<PostDto>
@{
    ViewData["Title"] = "Přehled";
}

<section class="hero">
    <div class="container">
        <h1>Sdílej, co tě zajímá.</h1>
        <p class="lead">Jednoduchá sociální síť pro sdílení příspěvků a interakci s přáteli.</p>
        @if (User.Identity?.IsAuthenticated != true)
        {
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg">Začít zdarma</a>
        }
    </div>
</section>

<section class="container">
    @if (User.Identity?.IsAuthenticated != true)
    {
        <div class="features">
            <article class="card">
                <h2>Příspěvky</h2>
                <p>Pište a sdílejte své myšlenky.</p>
            </article>
            <article class="card">
                <h2>Komentáře</h2>
                <p>Diskutujte pod příspěvky ostatních.</p>
            </article>
            <article class="card">
                <h2>Interakce</h2>
                <p>Sledujte a lajkujte.</p>
            </article>
        </div>
    }

    <h2>Nejnovější příspěvky</h2>
    @if (Model.Count == 0)
    {
        <article class="card">
            <p>Zatím tu nic není. Buďte první, kdo něco napíše!</p>
        </article>
    }
    @foreach (var post in Model)
    {
        <partial name="_PostCard" model="post" />
    }
</section>

@model RegisterDto
@{
    ViewData["Title"] = "Registrace";
}

<section class="container page narrow">
    <article class="card">
        <h2>Registrace</h2>
        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="DateOfBirth"></label>
                <input asp-for="DateOfBirth" type="date" class="form-control" />
                <span asp-validation-for="DateOfBirth" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>
            <button type="submit" class="btn btn-primary">Vytvořit účet</button>
            <a asp-action="Login" class="btn btn-ghost">Už mám účet</a>
        </form>
    </article>
</section>

@model PostInputDto
@{
    ViewData["Title"] = "Upravit příspěvek";
}

<section class="container page">
    <article class="card">
        <h2>Upravit příspěvek</h2>
        <form asp-action="Edit" asp-route-id="@ViewData["PostId"]" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="form-group">
                <label asp-for="Content"></label>
                <textarea asp-for="Content" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Content" class="field-error"></span>
            </div>
            <input type="hidden" asp-for="ImagePath" />
            @if (Model.ImagePath is not null)
            {
                <div class="form-group">
                    <img src="@Model.ImagePath" alt="Aktuální obrázek" class="post-image-preview" />
                    <div class="form-check">
                        <input asp-for="RemoveImage" type="checkbox" />
                        <label asp-for="RemoveImage"></label>
                    </div>
                </div>
            }
            <div class="form-group">
                <label for="image">@(Model.ImagePath is null ? "Přidat obrázek" : "Nahradit obrázek")</label>
                <input type="file" id="image" name="image" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" />
                @Html.ValidationMessage("Image", new { @class = "field-error" })
            </div>
            <button type="submit" class="btn btn-primary">Uložit změny</button>
            <a asp-action="Details" asp-route-id="@ViewData["PostId"]" class="btn btn-ghost">Zpět</a>
        </form>
    </article>
</section>

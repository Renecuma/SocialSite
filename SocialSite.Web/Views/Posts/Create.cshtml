@model PostInputDto
@{
    ViewData["Title"] = "Nový příspěvek";
}

<section class="container page">
    <article class="card">
        <h2>Vytvořit nový příspěvek</h2>
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="form-group">
                <label asp-for="Content"></label>
                <textarea asp-for="Content" class="form-control" rows="5" placeholder="Co máte na mysli?"></textarea>
                <span asp-validation-for="Content" class="field-error"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-lg">Publikovat</button>
        </form>
    </article>
</section>

@model PostDetailViewModel
@{
    ViewData["Title"] = "Příspěvek";
}

<section class="container page">
    <partial name="_PostCard" model="Model.Post" />

    <h3>Komentáře</h3>
    <div class="item-list">
        @if (Model.Post.Comments.Count == 0)
        {
            <p class="muted">Zatím žádné komentáře.</p>
        }
        @foreach (var comment in Model.Post.Comments)
        {
            <div class="item-row">
                <div>
                    <a asp-controller="Profile" asp-action="Index" asp-route-id="@comment.AuthorId" class="post-author">@comment.AuthorName</a>
                    <span class="muted">@comment.CreatedAt.ToLocalTime().ToString("d. M. yyyy H:mm")</span>
                    <p class="comment-text">@comment.Text</p>
                    @if (comment.ImagePath is not null)
                    {
                        <a href="@comment.ImagePath" target="_blank" class="post-image-link">
                            <img src="@comment.ImagePath" alt="Obrázek ke komentáři" class="comment-image" loading="lazy" />
                        </a>
                    }
                </div>
                @if (comment.IsMine)
                {
                    <form asp-action="DeleteComment" asp-route-id="@comment.Id" method="post" class="inline-form">
                        <button type="submit" class="btn btn-sm btn-danger">Smazat</button>
                    </form>
                }
            </div>
        }
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <article class="card comment-form">
            <form asp-action="Comment" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="NewComment.PostId" />
                <div class="form-group">
                    <label asp-for="NewComment.Text"></label>
                    <textarea asp-for="NewComment.Text" class="form-control" rows="3" placeholder="Napište komentář…"></textarea>
                    <span asp-validation-for="NewComment.Text" class="field-error"></span>
                </div>
                <div class="form-group">
                    <label for="image">Obrázek (nepovinné)</label>
                    <input type="file" id="image" name="image" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" />
                    @Html.ValidationMessage("Image", new { @class = "field-error" })
                </div>
                <button type="submit" class="btn btn-primary">Odeslat</button>
            </form>
        </article>
    }
</section>

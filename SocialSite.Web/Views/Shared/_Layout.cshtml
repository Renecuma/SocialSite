<!DOCTYPE html>
<html lang="cs">
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    string Active(string c, string? a = null)
        => area is null && controller == c && (a is null || action == a) ? "active" : "";
}
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>SocialSite - @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
    <header class="topbar">
        <div class="container topbar-inner">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="logo">SocialSite</a>
            <nav class="nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager))
                    {
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-ghost">Správa</a>
                    }
                    <a asp-area="" asp-controller="Posts" asp-action="Create" class="btn btn-primary">+ Příspěvek</a>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                        <button type="submit" class="btn btn-ghost">Odhlásit</button>
                    </form>
                }
                else
                {
                    <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-ghost">Přihlásit se</a>
                    <a asp-area="" asp-controller="Account" asp-action="Register" class="btn btn-primary">Registrovat</a>
                }
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Navigační taby 5rem od spodního okraje -->
        <nav class="bottom-tabs">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="tab-item @Active("Home")">
                <svg class="tab-icon" viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
                <span>Domů</span>
            </a>
            <a asp-area="" asp-controller="Posts" asp-action="Create" class="tab-item @Active("Posts", "Create")">
                <svg class="tab-icon" viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
                <span>Příspěvek</span>
            </a>
            <a asp-area="" asp-controller="Notifications" asp-action="Index" class="tab-item @Active("Notifications")">
                <svg class="tab-icon" viewBox="0 0 24 24"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/></svg>
                <span>Oznámení</span>
            </a>
            <a asp-area="" asp-controller="Profile" asp-action="Index" asp-route-id="" class="tab-item @Active("Profile", "Index")">
                <svg class="tab-icon" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                <span>Profil</span>
            </a>
            <a asp-area="" asp-controller="Profile" asp-action="Edit" class="tab-item @Active("Profile", "Edit")">
                <svg class="tab-icon" viewBox="0 0 24 24"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>
                <span>Nastavení</span>
            </a>
        </nav>
    }

    <footer class="footer">
        <div class="container">© 2026 SocialSite</div>
    </footer>
</body>
</html>

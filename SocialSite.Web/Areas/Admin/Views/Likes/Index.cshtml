@model IReadOnlyList<LikeDto>
@{
    ViewData["Title"] = "Lajky";
}

<section class="container page">
    <h2>Lajky</h2>
    <partial name="_AdminNav" />

    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr><th>Uživatel</th><th>Příspěvek</th><th>Kdy</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var like in Model)
                {
                    <tr>
                        <td>@like.UserName</td>
                        <td class="cell-text"><a asp-area="" asp-controller="Posts" asp-action="Details" asp-route-id="@like.PostId">@like.PostExcerpt</a></td>
                        <td>@like.CreatedAt.ToLocalTime().ToString("d. M. yyyy H:mm")</td>
                        <td class="table-actions">
                            <form asp-action="Delete" asp-route-id="@like.Id" method="post" class="inline-form">
                                <button type="submit" class="btn btn-sm btn-danger">Smazat</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
